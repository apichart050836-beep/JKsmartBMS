# Copy to server/.env (never commit .env - only .env.example). Nothing here
# is bundled into the frontend - this file is read by the Node backend only.

PORT=10000
CLIENT_ORIGIN=http://localhost:5173

# Long random string - used to sign session JWTs. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
COOKIE_NAME=bms_session

# SQLite file - created automatically on first run, never deleted by schema.sql.
DB_PATH=./data/app.db

# Firebase Admin SDK - Firebase Console > Project Settings > Service Accounts
# > Generate new private key. Save the downloaded JSON here (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://jkbms-32dfe-default-rtdb.asia-southeast1.firebasedatabase.app

# Git-backed firmware storage (server/gitStorage.js) - lets the admin
# firmware upload panel commit the .bin into this repo's own firmware/
# folder and get a real raw.githubusercontent.com URL back. A GitHub
# Personal Access Token with `repo` scope (Settings > Developer settings >
# Personal access tokens).
GITHUB_TOKEN=
# REQUIRED on Render (or any host whose deploy checkout doesn't preserve a
# real "origin" remote / lands in detached-HEAD - confirmed true on Render).
# Not needed for local dev, where `git remote`/`git rev-parse` on your own
# clone already resolve correctly.
GITHUB_REPO=apichart050836-beep/JKsmartBMS
GITHUB_BRANCH=main

# MQTT broker (HiveMQ Cloud or similar) - the real per-device OTA signal
# transport, replacing the old Firebase firmware node write. The admin
# publish panel and the dashboard's "trigger update" both PUBLISH a
# {latest_version, update_flag, uploaded_at, url} JSON message to
# jk_bms_hub/{hubId}/{bmsKey}/command, which the ESP32's own firmware
# subscribes to. Create credentials in your HiveMQ Cloud Console under
# Access Management. MQTT_URL must include the mqtts:// scheme and :8883 TLS
# port.
MQTT_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Admin seed data (server/db/seed.js reads these - edit before running
# `npm run seed` so the real admin account isn't the literal spec default in
# production).
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=P@ssw0rd

# Shared password for every hub-owner ('user' role) login - identity is
# just "does a hub matching this email exist" (see routes/auth.js), not a
# per-account password from Firebase.
DEFAULT_USER_PASSWORD=123456
