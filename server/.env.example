# Copy to server/.env (never commit .env - only .env.example). Nothing here
# is bundled into the frontend - this file is read by the Node backend only.

PORT=10000
CLIENT_ORIGIN=http://localhost:5173

# Long random string - used to sign session JWTs. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
COOKIE_NAME=bms_session

# SQLite file - created automatically on first run, never deleted by schema.sql.
DB_PATH=./data/app.db

# Firebase Admin SDK - Firebase Console > Project Settings > Service Accounts
# > Generate new private key. Save the downloaded JSON here (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://jkbms-32dfe-default-rtdb.asia-southeast1.firebasedatabase.app

# Git-backed firmware storage (server/gitStorage.js) - lets the admin
# firmware upload panel commit the .bin into this repo's own firmware/
# folder and get a real raw.githubusercontent.com URL back. A GitHub
# Personal Access Token with `repo` scope (Settings > Developer settings >
# Personal access tokens).
GITHUB_TOKEN=
# REQUIRED on Render (or any host whose deploy checkout doesn't preserve a
# real "origin" remote / lands in detached-HEAD - confirmed true on Render).
# Not needed for local dev, where `git remote`/`git rev-parse` on your own
# clone already resolve correctly.
GITHUB_REPO=apichart050836-beep/JKsmartBMS
GITHUB_BRANCH=main

# Personal LINE push notifications (server/lineAuth.js + lineNotify.js +
# lineAlertWatchdog.js) - "LINE Notify" (the old single-token webhook
# service) was discontinued by LINE in 2025, so this uses the current LINE
# Messaging API + LINE Login instead. Setup, in the LINE Developers Console
# (https://developers.line.biz/console/):
#   1. Create a Provider (any name).
#   2. Under it, create a "Messaging API" channel - this is what actually
#      sends push messages. Copy its Channel Access Token (long-lived) from
#      the channel's Messaging API tab into LINE_MESSAGING_CHANNEL_ACCESS_TOKEN.
#   3. Under the SAME Provider, create a "LINE Login" channel - this is what
#      lets a user link their account (OAuth) so the app learns their LINE
#      userId. Copy its Channel ID and Channel secret into
#      LINE_LOGIN_CHANNEL_ID / LINE_LOGIN_CHANNEL_SECRET.
#   4. In that LINE Login channel's settings, add a Callback URL matching
#      LINE_LOGIN_REDIRECT_URI below exactly (must be the real deployed URL
#      in production, e.g. https://<your-app>.onrender.com/api/line/callback).
#   5. Both channels must be under the same Provider, and each hub-owner
#      must add your Messaging API channel's Official Account as a LINE
#      friend at least once, or LINE will silently refuse to deliver push
#      messages to them even after they complete the Login link.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:10000/api/line/callback

# Weather condition alerts (lineAlertWatchdog.js's checkWeather, per
# explicit request) - same OpenWeatherMap key already used by the frontend's
# VITE_OPENWEATHER_KEY (see .env.example at the repo root), just also
# copied here as a plain (non-VITE_) var since this one needs to be readable
# by the Node backend at runtime, not baked into the browser bundle. Get it
# from https://openweathermap.org/api if you don't have one yet - the same
# value works in both places.
OPENWEATHER_KEY=

# Admin seed data (server/db/seed.js reads these - edit before running
# `npm run seed` so the real admin account isn't the literal spec default in
# production).
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=P@ssw0rd

# Shared password for every hub-owner ('user' role) login - identity is
# just "does a hub matching this email exist" (see routes/auth.js), not a
# per-account password from Firebase.
DEFAULT_USER_PASSWORD=123456
